@model List<Fecomvr1._2.Entidades.Producto>
@Html.AntiForgeryToken()
@{
    ViewData["Title"] = "Productos";
    var totalProductos = Model.Count;
}

<div class="container-fluid mt-3">
    <div class="card text-white shadow-sm mb-4" style="background: linear-gradient(135deg, #007bff, #00c6ff);">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <h2><i class="bi bi-box"></i> Productos</h2>
                <p>Total de productos: <strong>@totalProductos</strong></p>
            </div>
           @*  <div class="input-group w-auto">
                <span class="input-group-text bg-light"><i class="bi bi-search"></i></span>
                <input type="text" id="buscarInput" class="form-control" placeholder="Buscar producto...">
            </div> *@
            <a asp-action="Create" class="btn btn-light rounded-circle shadow ms-2" title="Agregar Producto">
                <i class="bi bi-plus-lg fs-4"></i>
            </a>
        </div>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table id="productosTable" class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Categoría</th>
                    <th>Proveedor</th>
                    <th>Modificar</th>
                    <th>Eliminar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in Model)
                {
                    <tr>
                        <td>@producto.Nombre</td>
                        <td>@producto.Precio.ToString("N2")</td>
                        <td>@producto.Stock</td>
                        <td>@producto.CategoriaId</td>
                        <td>@producto.ProveedorId</td>
                        <td>
                            <a asp-controller="Producto" asp-action="Editar" asp-route-id="@producto.ProductoId" class="btn btn-warning btn-sm">
                                <i class="bi bi-pencil-square"></i>
                            </a>
                        </td>
                        <td>
                            <button type="button" class="btn btn-danger btn-sm"
                                    onclick="confirmarEliminacion(@producto.ProductoId, '@producto.Nombre')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        $(document).ready(function () {
            var table = $('#productosTable').DataTable({
                language: { url: '//cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json' },
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                ordering: true,
                dom: 'lrtip'
            });

            $('#buscarInput').on('keyup', function () {
                table.search(this.value).draw();
            });
        });

        function confirmarEliminacion(productoId, productoNombre) {
            Swal.fire({
                title: '¿Está seguro de eliminar el registro?',
                html: '<strong>' + productoId + '</strong> - <strong>' + productoNombre + '</strong> será eliminado.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Eliminar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    // Crear un formulario dinámico para enviar POST seguro
                    const form = document.createElement('form');
                    form.method = 'post';
                    form.action = `/Producto/Eliminar/${productoId}`;

                    // Anti-forgery token
                    const antiForgeryInput = document.createElement('input');
                    antiForgeryInput.type = 'hidden';
                    antiForgeryInput.name = '__RequestVerificationToken';
                    antiForgeryInput.value = $('input[name="__RequestVerificationToken"]').val();
                    form.appendChild(antiForgeryInput);

                    document.body.appendChild(form);
                    form.submit();
                }
            });
        }
    </script>
}

