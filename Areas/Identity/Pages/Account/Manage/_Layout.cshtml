@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12 text-center">
            <h2 class="fw-bold text-primary"><i class="bi bi-person-gear"></i> Configuración de Cuenta</h2>
            <p class="text-muted">Gestiona tu información personal y opciones de seguridad</p>
            <hr />
        </div>
    </div>

    <div class="row">
        <!-- Menú de navegación -->
        <div class="col-md-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h5 class="fw-semibold"><i class="bi bi-menu-button"></i> Menú</h5>
                    <hr />
                    <partial name="_ManageNav" />
                </div>
            </div>
        </div>

        <!-- Cuerpo -->
        <div class="col-md-9">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}